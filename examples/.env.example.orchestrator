# ==============================================================================
# KAEDE - Orchestrator Bot Configuration
# ==============================================================================
# This configuration is for the dedicated Orchestrator Bot.
# The Orchestrator Bot does NOT process normal conversation messages and does NOT
# require any AI provider credentials (like COPILOT_API_KEY, ANTHROPIC_API_KEY, etc.).
# It only registers and handles administrative slash commands (e.g. /clear, /restart).
# To run this bot, use `npm run orchestrator`.
# ==============================================================================

# Required: The Discord Bot Token specifically for the Orchestrator
DISCORD_BOT_TOKEN="your_orchestrator_bot_token_here"

# The name of the agent (used for PM2 and config directory paths)
AGENT_NAME="orchestrator"

# Note: No AGENT_PROVIDER or API keys are required here.
