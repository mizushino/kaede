# Bot 設定
AGENT_NAME=codex                # エージェント名
AI_PROVIDER=codex               # AI プロバイダー
CODEX_MODEL=                    # 使用する AI モデル (例: gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-5.3-codex, 空=Codex CLI のデフォルト)
REASONING_EFFORT=               # 推論レベル (minimal/low/medium/high/xhigh, 空=モデルのデフォルト)

# Codex SDK 関連
CODEX_API_KEY=                  # OpenAI API キー (空=`codex login` 済みの認証情報を使用)
CODEX_BASE_URL=                 # OpenAI 互換のカスタムエンドポイント (空=デフォルト)
CODEX_PATH=                     # codex 実行ファイルのパス (空=SDK 同梱の native binary を自動選択)
CODEX_SANDBOX_MODE=workspace-write   # サンドボックス (read-only / workspace-write / danger-full-access)
CODEX_APPROVAL_POLICY=never     # 承認ポリシー (never / on-request / on-failure / untrusted)
CODEX_NETWORK_DISABLED=         # 値を入れるとサンドボックス内のネットワークを無効化
CODEX_WEB_SEARCH_DISABLED=      # 値を入れると組み込みウェブ検索を無効化
CODEX_CONFIG_JSON=              # 追加 --config を JSON で注入 (例: {"history":{"persistence":"none"}})

# タイムアウト設定
WAIT_TIMEOUT_MS=1800000         # メッセージ待機タイムアウト (default: 30min)
SESSION_TIMEOUT_MS=10800000     # セッションタイムアウト (default: 3hour)

# セッションスコープ
SESSION_SCOPE=channel           # セッションの共有範囲 (channel=チャンネル単位 / server=サーバー単位)

# ディレクトリ設定
WORKSPACE_DIR=./workspace       # AI の作業ディレクトリ
TEMPORARY_DIR=./tmp             # 添付画像等の一時保存先
FUNCTIONS_DIR=                  # 関数ディレクトリ (空={WORKSPACE_DIR}/functions)
PROMPTS_DIR=                    # プロンプトディレクトリ (空={WORKSPACE_DIR}/.github/prompts)
AGENTS_MD_PATH=                 # カスタム AGENTS.md のパス (空=WORKSPACE_DIR の AGENTS.md を使用)

# 権限設定
# 自動承認する操作 (カンマ区切り: shell,write,read,url,mcp,custom-tool / *=全て自動承認)
PERMISSION_AUTO_APPROVE=*
# ユーザー応答タイムアウト (default: 300s)
USER_RESPONSE_TIMEOUT_MS=300000

# Discord
# トークンは https://discord.com/developers/applications で取得 (Privileged Gateway Intents: Message Content Intent を ON にする)
DISCORD_BOT_TOKEN=your_bot_token_here
