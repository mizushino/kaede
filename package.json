{
  "name": "kaede",
  "version": "1.0.0",
  "type": "module",
  "description": "kaede - Discord Bot with GitHub Copilot SDK integration",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx --env-file=.env${AGENT:+.$AGENT} src/index.ts",
    "copilot": "AGENT=copilot npm start",
    "claude": "AGENT=claude npm start",
    "mcp": "tsx --env-file=.env${AGENT:+.$AGENT} src/mcp/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.126",
    "@github/copilot-sdk": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "discord.js": "^14.26.3",
    "node-cron": "^4.2.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
