# Agent 設定
AGENT_NAME=gemini                # エージェント名
AGENT_PROVIDER=gemini            # AI プロバイダー
AGENT_MODEL=auto-gemini-3        # 使用する AI モデル (auto-gemini-3, auto-gemini-2.5, gemini-3-pro-preview, gemini-3-flash-preview, gemini-3.1-flash-lite-preview など)

# Gemini CLI / ACP 関連
GEMINI_COMMAND=                  # gemini 実行ファイルのパス or コマンド (空=node_modules/.bin/gemini → PATH 上の gemini)
GEMINI_ARGS=                     # gemini に渡す追加引数 (空=--acp のみ)
GEMINI_APPROVAL_MODE=default     # セッションモード (default / auto-edit / yolo / plan)
GEMINI_CLI_TRUST_WORKSPACE=true  # headless 実行時に trust ダイアログをスキップ
# GEMINI_API_KEY=                # API キー認証を使う場合
# GEMINI_CLI_HOME=               # ログイン情報の保存先を切り替える場合

# セッションスコープ
SESSION_SCOPE=channel            # セッションの共有範囲 (channel=チャンネル単位 / server=サーバー単位)

# ディレクトリ設定
WORKSPACE_DIR=./workspace        # AI の作業ディレクトリ
TEMPORARY_DIR=./tmp              # 添付画像等の一時保存先
FUNCTIONS_DIR=                   # 関数ディレクトリ (空={WORKSPACE_DIR}/functions)
PROMPTS_DIR=                     # プロンプトディレクトリ (空={WORKSPACE_DIR}/prompts と {WORKSPACE_DIR}/.github/prompts)
AGENTS_MD_PATH=                  # カスタム AGENTS.md のパス (空=WORKSPACE_DIR の AGENTS.md を使用)

# AI ツール設定 (空/1=true, 0=false)
ENABLE_FUNCTION_TOOLS=1
ENABLE_SCHEDULE_TOOLS=1

# 応答モード (all=全メッセージ, mention=@メンション/リプライのみ, keyword=メンション or キーワードマッチ)
RESPONSE_MODE=all
# キーワード (カンマ区切り、大文字小文字無視、部分一致)。空の場合は AGENT_NAME を使用
RESPONSE_KEYWORDS=

# 権限設定
# 自動承認する操作 (カンマ区切り: shell,write,read,url,mcp,custom-tool / *=全て自動承認)
PERMISSION_AUTO_APPROVE=*
# ユーザー応答タイムアウト (default: 300s)
USER_RESPONSE_TIMEOUT_MS=300000

# Discord
# トークンは https://discord.com/developers/applications で取得 (Privileged Gateway Intents: Message Content Intent を ON にする)
DISCORD_BOT_TOKEN=your_bot_token_here
